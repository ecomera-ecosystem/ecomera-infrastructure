# ========================================
# Ecomera Infrastructure Environment
# ========================================
# Copy this file to .env and adjust values

# PostgreSQL
POSTGRES_DB=ecomera
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vault (auto-generated on first start)
# After docker-compose up, copy VAULT_TOKEN from vault-creds/vault.env
# into each microservice's .env file
