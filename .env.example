# ========================================
# Ecomera Infrastructure Environment
# ========================================
# Copy this file to .env and adjust values

# PostgreSQL
POSTGRES_DB=ecomera
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Vault
# After first `docker compose up`, the Root Token is printed to vault logs:
#   docker logs ecomera-infra-vault 2>&1 | grep "Root Token"
# Then copy VAULT_TOKEN into each microservice's .env file.
